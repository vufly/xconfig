{{- $mise := lookPath "mise" -}}
{{- if not $mise -}}{{- fail "mise must be installed and on PATH before configuring FFF MCP" -}}{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "opencode-wakatime",
    "@plannotator/opencode@latest"
  ],
  "provider": {
    "openai": {
      "options": {
        "baseURL": "{{ if lookPath "bw" }}{{ (bitwardenFields "item" "cliproxy").baseUrl.value }}{{ end }}"
      }
    }
  },
  "small_model": "openai/gpt-5.6-luna",
  "mcp": {
    "fff": {
      "type": "local",
      "command": [{{ $mise | toJson }}, "exec", "--", "fff-mcp"],
      "enabled": true
    }
  }
}
