{{- $mise := lookPath "mise" -}}
{{- if not $mise -}}{{- fail "mise must be installed and on PATH before configuring FFF MCP" -}}{{- end -}}
{{- $magy := lookPath "magy-mcp" -}}
{{- if not $magy -}}{{- fail "magy-mcp must be installed and on PATH before configuring Magy MCP" -}}{{- end -}}
{{- $state := dict -}}
{{- if .chezmoi.stdin | trim -}}
  {{- $state = fromJson .chezmoi.stdin | default dict -}}
{{- end -}}
{{- $servers := get $state "mcpServers" | default dict -}}
{{- $existingFff := get $servers "fff" | default dict -}}
{{- $fff := dict "command" $mise "args" (list "exec" "--" "fff-mcp") -}}
{{- if hasKey $existingFff "disabled" -}}
  {{- $_ := set $fff "disabled" (get $existingFff "disabled") -}}
{{- end -}}
{{- $_ := set $servers "fff" $fff -}}
{{- $existingMagy := get $servers "magy" | default dict -}}
{{- $magyConfig := dict "command" $magy -}}
{{- if hasKey $existingMagy "disabled" -}}
  {{- $_ := set $magyConfig "disabled" (get $existingMagy "disabled") -}}
{{- end -}}
{{- $_ := set $servers "magy" $magyConfig -}}
{{- $_ := set $state "mcpServers" $servers -}}
{{- $state | toPrettyJson "  " -}}
