{{/* chezmoi:template:line-endings=lf */}}
{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh

set -eu

# Verij owns adapter assets and machine-local paths; do not copy them into dotfiles.
if ! command -v verij >/dev/null 2>&1 || ! command -v pi >/dev/null 2>&1; then
  exit 0
fi

pi_version="$(pi --version)"
if [ "$pi_version" != "1.2.0" ]; then
  printf '[chezmoi] Skipping Verij Pi monitoring: Pi %s is unsupported (requires 1.2.0).\n' "$pi_version" >&2
  exit 0
fi

# Idempotent setup honors PI_CODING_AGENT_DIR and preserves other extensions/settings.
verij agent setup pi
{{ end -}}
